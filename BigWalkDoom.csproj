<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<AssemblyName>BigWalkDoom</AssemblyName>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<!-- IL2CPP interop assemblies use unsafe pointer patterns under the hood -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<GameDir>C:\Program Files (x86)\Steam\steamapps\common\Big Walk</GameDir>
	</PropertyGroup>

	<ItemGroup>
		<!--
      These come from the game install, generated the first time BepInEx runs:
        <BigWalk>\BepInEx\interop\*.dll
      Point HintPath at your local Big Walk install. At minimum you'll need
      Assembly-CSharp.dll (to find the couch/screen/player types),
      UnityEngine.CoreModule.dll, UnityEngine.InputLegacyModule.dll
      (or UnityEngine.InputSystem.dll if the new Input System is used),
      Il2Cppmscorlib.dll.
    -->
		<Reference Include="Assembly-CSharp">
			<HintPath>$(GameDir)\BepInEx\interop\Assembly-CSharp.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(GameDir)\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.InputLegacyModule">
			<HintPath>$(GameDir)\BepInEx\interop\UnityEngine.InputLegacyModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.AudioModule.dll">
			<HintPath>$(GameDir)\BepInEx\interop\UnityEngine.AudioModule.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<!-- BepInEx Core Libraries -->
		<Reference Include="BepInEx.Core">
			<HintPath>$(GameDir)\BepInEx\core\BepInEx.Core.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="BepInEx.Unity.IL2CPP">
			<HintPath>$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="HarmonyLib">
			<HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<!-- Il2Cpp Interop Core Systems -->
		<Reference Include="Il2CppInterop.Runtime">
			<HintPath>$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Il2Cppmscorlib">
			<HintPath>$(GameDir)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<!-- Game-Specific Interop Assemblies -->
		<Reference Include="Mirror">
			<HintPath>$(GameDir)\BepInEx\interop\Mirror.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<!-- Stripped Unity Assemblies -->
		<Reference Include="UnityEngine">
			<HintPath>$(GameDir)\BepInEx\interop\UnityEngine.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.IMGUIModule">
			<HintPath>$(GameDir)\BepInEx\interop\UnityEngine.IMGUIModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.PhysicsModule">
			<HintPath>$(GameDir)\BepInEx\interop\UnityEngine.PhysicsModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.TextRenderingModule">
			<HintPath>$(GameDir)\BepInEx\interop\UnityEngine.TextRenderingModule.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile" />
		<PackageReference Include="BepInEx.Core" Version="6.0.0-be.*" IncludeAssets="compile" />
	</ItemGroup>

	<!--
    No explicit <Compile Include> block needed here - the SDK already picks up
    every .cs file under the project directory by default (that's what caused
    NETSDK1022: the block that used to be here duplicated that default glob).
    If you ever need to exclude something, use <Compile Remove="..."/> instead
    of trying to re-declare includes.
  -->

	<ItemGroup>
		<None Include="doom1.wad" CopyToOutputDirectory="PreserveNewest" />
		<None Include="TimGM6mb.sf2" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>